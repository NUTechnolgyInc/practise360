# Copy to .env for local dev. Real values live in Vercel env settings.
MONGODB_URI=mongodb://localhost:27017/practise360
# "dev" enables username + password login (password is "password" for every seeded user). Never set in production.
AUTH_MODE=dev
JWT_SECRET=[REDACTED]
# Web origin allowed by CORS (comma-separated for several)
WEB_ORIGIN=http://localhost:3000
# Invitation emails. Leave SMTP_URL empty locally: emails are printed to this console and the inviter gets the join link.
# SMTP_URL=smtps://[REDACTED]:[REDACTED]@smtp.example.com:465
# MAIL_FROM=Practise360 <no-reply@example.com>
# WEB_URL=http://localhost:3000
# INVITE_EMAIL_DOMAINS=example.com
