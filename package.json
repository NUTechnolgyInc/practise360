{
  "name": "practise360",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build --workspaces --if-present",
    "tracker": "node scripts/tracker/serve.mjs",
    "tracker:build": "node scripts/tracker/parse-tracker.mjs",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:ui": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report e2e/report/html"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
